    { "item_type": "grammar", "jlpt_level": "N4", "question_type": "grammar_sentence_blank", "source_item": "ばかり", "source_reading": null, "source_meaning": null, "source_day": "n4-mock-realistic-004", "question_text": "この町に引っ越してきた（　）で、まだ道がよく分かりません。", "choice_a": "ほど", "choice_b": "つもり", "choice_c": "かわり", "choice_d": "ばかり", "correct_choice": "D", "explanation": "막 한 직후의 상태에는 「たばかり」입니다.", "review_status": "draft", "generation_batch": "n4-realistic-mock-exam-004", "id": "n4r4_grammar_32", "mock_exam_set_code": "n4-realistic-mock-exam-004", "section_key": "grammar", "section_sort_order": 2, "sort_order": 32, "points": 1, "source_stage": "n4_mock_realistic_004" },
