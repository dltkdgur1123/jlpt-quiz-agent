    { "item_type": "grammar", "jlpt_level": "N4", "question_type": "grammar_sentence_blank", "source_item": "そうだ", "source_reading": null, "source_meaning": null, "source_day": "n4-mock-realistic-004", "question_text": "このケーキは色がきれいで、おいし（　）ですね。", "choice_a": "そう", "choice_b": "らしい", "choice_c": "ため", "choice_d": "ずつ", "correct_choice": "A", "explanation": "겉보기 판단에는 형용사 어간 + 「そう」를 씁니다.", "review_status": "draft", "generation_batch": "n4-realistic-mock-exam-004", "id": "n4r4_grammar_29", "mock_exam_set_code": "n4-realistic-mock-exam-004", "section_key": "grammar", "section_sort_order": 2, "sort_order": 29, "points": 1, "source_stage": "n4_mock_realistic_004" },
