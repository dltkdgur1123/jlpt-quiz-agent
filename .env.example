# Supabase browser client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Auth provider plan: Google, Kakao, Naver, Email.
# Google/Kakao provider client IDs/secrets are configured in Supabase dashboard, not stored here.
# Naver uses an app-owned server callback because Supabase Custom OAuth cannot map response.id/response.email.
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NEXT_PUBLIC_SITE_URL=https://your-site.example.com
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Add service-role keys only in backend/admin-only contexts and never expose them to the browser.

# Server-only YouTube Data API key for latest Shorts thumbnails on the homepage.
# Do not prefix with NEXT_PUBLIC_; this must stay server-side.
YOUTUBE_API_KEY=your-youtube-data-api-key

# Server-only comma-separated admin email allowlist.
# Do not prefix with NEXT_PUBLIC_; this must stay server-side.
ADMIN_EMAILS=admin@example.com
